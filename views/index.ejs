<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>修行者名簿</title>
</head>
<body>
  <h1>修行者名簿</h1>
  <ul>
    <% users.forEach(user => { %>
      <li><%= user.name %> (ID: <%= user.id %>)</li>
    <% }) %>
  </ul>

  <h2>新しい修行者を登録する</h2>
  <form action="/users" method="post">
    <input type="text" name="name" placeholder="名前を入力しておくれ" required>
    <button type="submit">登録じゃ</button>
  </form>
</body>
</html>
